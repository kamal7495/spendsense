# Google service account used to read/write the Google Sheet.
# Share the target Sheet with this account's email as an Editor.
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com

# The service account's private key, as found in the downloaded JSON key file.
# Keep the surrounding quotes and \n escape sequences intact (Vercel env vars
# support multi-line values pasted directly with real newlines as well).
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# The ID of the Google Sheet (from its URL:
# https://docs.google.com/spreadsheets/d/SHEET_ID/edit)
GOOGLE_SHEET_ID=your-google-sheet-id
